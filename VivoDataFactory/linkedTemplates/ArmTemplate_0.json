								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"Loop_Data": {
						"type": "array",
						"defaultValue": [
							{
								"Schema": "dbo",
								"table": "DimUser",
								"Column_dt": "updated_at",
								"From_Date": ""
							},
							{
