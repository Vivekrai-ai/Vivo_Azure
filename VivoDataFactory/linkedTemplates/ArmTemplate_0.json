													{
														"referenceName": "Json1",
														"type": "DatasetReference",
														"parameters": {
															"Container": "bronze",
															"Folder": {
																"value": "CDC_@{item().table}",
																"type": "Expression"
															},
															"File": "Last_Date.json"
														}
													}
												]
											}
										]
									}
								}
							]
						}
					},
					{
						"name": "Alert Generation - SUCCESS",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "ForEach1",
								"dependencyConditions": [
									"Succeeded"
