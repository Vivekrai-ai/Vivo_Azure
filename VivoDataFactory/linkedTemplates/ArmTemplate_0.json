							"body": {
								"value": "{\n    \"Pipeline_Name\":\"@{pipeline().Pipeline}\",\n    \"Run_Id\": \"@{pipeline().RunId}\",\n    \"Status\": \"Success\"\n}",
								"type": "Expression"
